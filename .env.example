# ──────────────────────────────────────────────
# SANTANA FAMILY — Variables d'environnement
# Copiez ce fichier en `.env` et remplissez les valeurs.
# ──────────────────────────────────────────────

# Base de données PostgreSQL (Neon)
# Fournie automatiquement par l'intégration Neon sur Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Assistant SANTANA AI — clé API OpenAI
OPENAI_API_KEY="sk-..."

# Envoi des e-mails de candidature (Resend)
RESEND_API_KEY="re_..."

# Administration — mot de passe unique de connexion
ADMIN_PASSWORD="changez-ce-mot-de-passe"

# Secret utilisé pour signer les sessions admin (JWT)
# Générez-en un avec : openssl rand -base64 32
JWT_SECRET="votre-secret-aleatoire-de-32-caracteres-minimum"
